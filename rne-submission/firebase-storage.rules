rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // R&E 신규 제출 공간. 기존 저장소 규칙이 있다면 이 블록만 병합하세요.
    match /rneSubmission2026/{uid}/{kind}/{filename} {
      function isTeacher() {
        return request.auth != null
          && request.auth.uid == "REPLACE_WITH_EUNHAENG_TEACHER_UID"
          && request.auth.token.firebase.sign_in_provider == "google.com";
      }
      function isStudentUploader() {
        return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == "anonymous";
      }
      allow read: if isTeacher() || isStudentUploader();
      allow create: if isStudentUploader()
        && (kind == "report" || kind == "presentation")
        && filename.matches('^[a-zA-Z0-9-]+\\.(pdf|hwpx|hwp|docx|pptx|ppt)$')
        && request.resource.size > 0
        && request.resource.size <= 26214400;
      allow update, delete: if false;
    }
  }
}
